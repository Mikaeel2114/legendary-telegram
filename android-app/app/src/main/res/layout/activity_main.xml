<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- LIVE STREAM CANVAS LAYER -->
    <com.pulselink.cast.ui.ZoomableStreamView
        android:id="@+id/streamViewport"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- TOP BAR: APP BRANDING + ANIMATED NIGHT/DAY THEME SWITCH -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/app_logo_hero"
            android:contentDescription="PulseLink Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PulseLink Cast"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConnectionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modem / Wi-Fi / Localhost Ready"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleTheme"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="🌙 Night / ☀️"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- CENTER CONNECTION & LAN AUTO-DISCOVERY CARD -->
    <ScrollView
        android:id="@+id/connectCardScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:id="@+id/ivHeroLogo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/app_logo_hero"
                android:contentDescription="Hero Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Connect to Windows PC"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Enter your Windows Modem/Wi-Fi IP (e.g. 192.168.1.x) or 127.0.0.1 for USB ADB Localhost"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etHostIp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:hint="Windows Host IP (e.g. 192.168.1.42 or 127.0.0.1)"
                android:inputType="textUri"
                android:paddingHorizontal="14dp"
                android:text="192.168.1.100"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <EditText
                android:id="@+id/etPort"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:hint="Port (Default 5959)"
                android:inputType="number"
                android:paddingHorizontal="14dp"
                android:text="5959"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnScanLan"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill_button"
                    android:text="📡 Auto-Scan Wi-Fi"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnLocalhostPreset"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_button"
                    android:text="⚡ Localhost 127.0.0.1"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnStartConnect"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill_button"
                android:text="🚀 Connect &amp; Stream Windows Screen"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <!-- LIVE TELEMETRY HUD OVERLAY -->
    <TextView
        android:id="@+id/tvHudOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="68dp"
        android:layout_marginStart="16dp"
        android:background="#AA090D16"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="FPS: 60 | Latency: 9 ms | 1080p"
        android:textColor="#22D3EE"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- FLOATING PRO TOOLS DOCK FOR BETTER STREAMING RESULTS -->
    <HorizontalScrollView
        android:id="@+id/floatingToolsDock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_glass_card"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolQualityPreset"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginHorizontal="4dp"
                android:text="⚡ Mode: Balanced" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolTouchMode"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginHorizontal="4dp"
                android:text="🖱️ Direct Touch" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolKeyboard"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginHorizontal="4dp"
                android:text="⌨️ PC Keys" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolSwitchMonitor"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginHorizontal="4dp"
                android:text="🖥️ Display #1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolSnapshot"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginHorizontal="4dp"
                android:text="📸 Snapshot" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolFullscreen"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginHorizontal="4dp"
                android:text="⛶ Fullscreen" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolDisconnect"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginHorizontal="4dp"
                android:text="❌ Disconnect" />
        </LinearLayout>
    </HorizontalScrollView>

</FrameLayout>
